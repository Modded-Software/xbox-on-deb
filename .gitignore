# Game data - copyrighted and very large; obtain the leak yourself.
res/
extracted/

# Third-party emulator binaries (Cxbx-Reloaded) - fetch separately, see README.
emulator/

# Runtime output: Cxbx/Wine logs, emulated console state, Proton logs.
logs/
*.log

# Python
__pycache__/
*.pyc
.venv/

# Scratch / screenshots
*.png

# Third-party reference repos cloned for study (not ours; see docs/).
refs/

# Recomp work: analysis/build artifacts are regenerable from the user's own XBE.
recomp/build/
# Symbol/source maps derived from the build's linker MAP + PDB: regenerable
# proprietary build data, never distributed.
recomp/symbols/
# Parallel game tree for A/B'ing a second runtime (see scripts/14-launch-recomp.sh
# GHOST_GAME_DIR); regenerable, 300+ MB of generated code and build output.
recomp/game-backup/
# Generated MinGW import libs (recomp/toolchain/make_import_libs.sh rebuilds them).
recomp/toolchain/lib/
.venv-recomp/
# Image-pipeline virtualenv (Pillow). See scripts/ghost-research/images.py.
.venv-wiki/

# Wiki imagery: real archived material, local only, built by images.py.
wiki/site/assets/media/

# Test capture artifact (recomp/tests framework F12 framebuffer dump).
recomp/game/framebuffer.bmp
*.bmp

# Reverse-engineering notes: internal addresses/names recovered from the build.
# Kept locally, never distributed.
recomp/diary/

# Game framebuffer captures (copyrighted imagery).
recomp/tests/baselines/captures/

# scaffold-ci Makefile backup (local artifact, not source).
Makefile.scaffold-bak.*

# Compiled objects/shared libraries: build from source (e.g. tools/allow_ptrace.c
# is compiled on demand by scripts/11-launch-ptraceable.sh).
*.o
*.so
