#!/bin/bash
# Shared configuration — source this from scripts: source "$(dirname "$0")/config.env"

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GAMES_DIR="$HOME/Games"
GAME_DATA_DIR="$REPO_ROOT/extracted/StarCraft Ghost Xbox Finn Hillbilly"
SCGHOST_PREFIX="$GAMES_DIR/scghost-prefix"
STEAM_ROOT="$HOME/.steam/root"
COMPAT_TOOLS_DIR="$STEAM_ROOT/compatibilitytools.d"

# --- GPU selection ---------------------------------------------------------
# Two identical Intel Arc A770s (8086:56a0) are exposed. GPU0 at PCI 03:00.0
# (renderD128) is shared with other host processes; GPU1 at PCI 09:00.0
# (renderD129) is ours. DRI_PRIME reorders the Vulkan device list so DXVK (and
# wined3d/GL) pick GPU1 first, and is loaded by every launch path that sources
# this file. Override in the environment with any of:
#   DRI_PRIME=pci-0000_03_00_0           # pin GPU0 instead
#   GPU_PCI=pci-0000_03_00_0             # same, via the GPU_PCI knob
#   DXVK_FILTER_DEVICE_UUID=<32 hex>     # override the exact lock
export DRI_PRIME="${DRI_PRIME:-${GPU_PCI:-pci-0000_09_00_0}}"

# Exact Vulkan lock. DRI_PRIME only reorders enumeration; DXVK enumerates and
# opens every device, so it can touch both render nodes. DXVK_FILTER_DEVICE_UUID
# (DXVK >= 2.3) hard-selects one device by its 32-hex, dashless Vulkan UUID
# (the bus differs in the 4th field), so only the chosen GPU is ever used.
#   GPU1 (09:00) = 8680a0560800000009000000000000
#   GPU0 (03:00) = 8680a0560800000003000000000000
if [[ "${DRI_PRIME}" == *"03_00"* ]]; then
    _gpu_default_uuid=8680a0560800000003000000000000
else
    _gpu_default_uuid=8680a0560800000009000000000000
fi
export DXVK_FILTER_DEVICE_UUID="${DXVK_FILTER_DEVICE_UUID:-$_gpu_default_uuid}"

# --- off-focus input -------------------------------------------------------
# Automated input goes through a control file the runtime polls
# (refs/xboxrecomp/src/video/fb_present.c:fb_inject_poll) instead of X focus,
# and the window is not forced foreground, so a run never steals the keyboard
# from whatever you are working in. Loaded by every launch path that sources
# this file. Override in the environment with:
#   RECOMP_NO_FOCUS=0    restore foreground/focus (hands-on keyboard play)
#   RECOMP_INPUT_FILE=... runtime-side path of the held-key file
#   RECOMP_INPUT_HOST=... host-side path xinject.py writes
export RECOMP_INPUT_FILE="${RECOMP_INPUT_FILE:-C:\\recomp-input.txt}"
export RECOMP_INPUT_HOST="${RECOMP_INPUT_HOST:-$SCGHOST_PREFIX/pfx/drive_c/recomp-input.txt}"
export RECOMP_NO_FOCUS="${RECOMP_NO_FOCUS:-1}"

# --- dynamic-buffer placement ----------------------------------------------
# The D3D11 backend holds one dynamic buffer per geometry/constant stream and
# writes ~15 MB of vertices into it every frame. DXVK backs those in cached
# (system) memory with cachedDynamicResources instead of uncached, which is the
# difference between ~28 and ~34 FPS in-game ("v"=vertex, "i"=index,
# "c"=constant). Override DXVK_CONFIG in the environment to change it.
export DXVK_CONFIG="${DXVK_CONFIG:-d3d11.cachedDynamicResources = vic}"

# Find installed GE-Proton by scanning compatibilitytools.d.
# Sets GE_PROTON_DIR if found, returns 1 otherwise.
find_ge_proton() {
    if [ ! -d "$COMPAT_TOOLS_DIR" ]; then
        return 1
    fi
    local dir
    for dir in "$COMPAT_TOOLS_DIR"/GE-Proton*/; do
        if [ ! -f "$dir/proton" ]; then
            continue
        fi
        if [ -f "$dir/files/bin/wine" ]; then
            GE_PROTON_DIR="$dir"
            return 0
        fi
    done
    return 1
}

detect_ge_proton() {
    if ! find_ge_proton; then
        echo "ERROR: No GE-Proton installation found in $COMPAT_TOOLS_DIR"
        echo "Run 03-install-proton.sh from the windows-on-deb repo first."
        exit 1
    fi
    echo "Found GE-Proton: $GE_PROTON_DIR"
}
