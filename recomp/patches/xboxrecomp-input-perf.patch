+/* ---- the output report: rumble -----------------------------------------
+ *
+ * The XID descriptor advertises a 6-byte output report (bMaxOutputReportSize 6)
+ * with two header bytes, so the actuators are the four bytes after them.
+ * Byte order is left then right. Each motor is a single byte 0-255; XInput
+ * wants 0-65535, so scale by 257 (0xFF -> 0xFFFF).
+ *
+ * ponytail: the exact byte order is inferred from the descriptor, not confirmed
+ * against a physical pad on this host. If rumble comes out swapped or dead,
+ * this is the one line to revisit; RECOMP_USB_TRACE prints the raw report.
+ */
+void usb_gamepad_output(const uint8_t *report, int len)
+{
+    XBOX_VIBRATION vib;
+    unsigned left, right;
+
+    if (len < 2)
+        return;
+    if (len >= 6) { left = report[2]; right = report[3]; }
+    else          { left = report[0]; right = report[1]; }
+
+    vib.wLeftMotorSpeed  = (WORD)(left * 257u);
+    vib.wRightMotorSpeed = (WORD)(right * 257u);
+    xbox_InputSetState(0, &vib);
+
+    if (getenv("RECOMP_USB_TRACE")) {
+        static unsigned n;
+        if (n++ < 20) {
+            fprintf(stderr, "  [USB] rumble report len=%d -> L=%u R=%u\n",
+                    len, vib.wLeftMotorSpeed, vib.wRightMotorSpeed);
+            fflush(stderr);
+        }
+    }
+}
