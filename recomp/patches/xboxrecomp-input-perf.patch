-            STACK_ARG(3), STACK_ARG(4));
-    fflush(stderr);
+    static volatile LONG n;
+    LONG c = InterlockedIncrement(&n);
+    if (c <= 20 || (c % 10000) == 0) {
+        fprintf(stderr, "  [KERNEL] *** KeBugCheckEx: code=0x%08X "
