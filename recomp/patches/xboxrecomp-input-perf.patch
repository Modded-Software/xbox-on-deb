+     * that renders at 30 FPS but polls the pad at 1 Hz is the difference
+     * between "laggy" and "broken", and nothing else in the chain shows it. */
+    {
+        static int trace = -1;
+        static unsigned long last;
+        static unsigned calls;
+        if (trace < 0)
