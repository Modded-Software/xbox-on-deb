@@ -358,7 +588,7 @@ BOOL xbox_InputIsConnected(DWORD dwPort)
     DWORD slot;
     if (dwPort >= XBOX_MAX_CONTROLLERS) return FALSE;
     return poll_host(dwPort, &state, &slot) == ERROR_SUCCESS ||
-        (dwPort == 0 && keyboard_enabled());
